// SPDX-License-Identifier: MIT
//
// Windows resources for gxdemo: the manifest and the icon.
//
// The manifest is not decoration. Without it Windows binds the process to
// comctl32 version 5, which exports SetWindowSubclass and GetWindowSubclass by
// ordinal only -- so a binary that imports them by name (as wxWidgets does)
// fails to start with:
//
//     The procedure entry point GetWindowSubclass could not be located in the
//     dynamic link library gxdemo.exe
//
// Defining wxUSE_RC_MANIFEST before including wx.rc pulls in the dependency on
// Common Controls 6.0, which is where those entry points exist by name. It also
// gets the program the themed native look rather than the Windows 95 one.

// 2 = per-monitor v2 DPI awareness. The operator's terminal and an engineer's
// laptop rarely run the same scaling, and without this the window is rendered
// at 96 dpi and stretched, which turns a log full of hex into mush.
#define wxUSE_RC_MANIFEST 1
#define wxUSE_DPI_AWARE_MANIFEST 2

// Explorer shows the alphabetically first icon of the executable, and wx's own
// icons start with "wx". The "aaa" prefix is what keeps this one in front of
// them; it is also the name wxICON() looks up for the window icon.
aaagxdemo ICON "Nosferatu.ico"

#include "wx/msw/wx.rc"
